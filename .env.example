# pgscatalog-link configuration
#
# Copy to .env and edit. All variables use the PGSCATALOG_LINK_ prefix.
# Nested settings use a double-underscore delimiter (e.g. PGSCATALOG_LINK_PGS__BASE_URL).

# --- Server ---
PGSCATALOG_LINK_HOST=127.0.0.1
PGSCATALOG_LINK_ALLOW_PUBLIC_BIND=false
PGSCATALOG_LINK_PORT=8000
# transport: unified | http | stdio
PGSCATALOG_LINK_TRANSPORT=unified
PGSCATALOG_LINK_MCP_PATH=/mcp
PGSCATALOG_LINK_ALLOWED_HOSTS='["localhost","127.0.0.1","::1"]'
PGSCATALOG_LINK_ALLOWED_ORIGINS='[]'
# Comma-separated list of allowed CORS origins (empty = none)
PGSCATALOG_LINK_CORS_ORIGINS=
# log_level: DEBUG | INFO | WARNING | ERROR | CRITICAL
PGSCATALOG_LINK_LOG_LEVEL=INFO
# log_format: json | console
PGSCATALOG_LINK_LOG_FORMAT=console

# --- PGS Catalog upstream (nested: pgs) ---
PGSCATALOG_LINK_PGS__BASE_URL=https://www.pgscatalog.org/rest
PGSCATALOG_LINK_PGS__REQUEST_TIMEOUT_S=20.0
# Politeness: the PGS Catalog REST API allows 100 requests/min; 0.6 s spacing stays under it.
PGSCATALOG_LINK_PGS__MIN_INTERVAL_S=0.6
PGSCATALOG_LINK_PGS__DAILY_CAP=20000
PGSCATALOG_LINK_PGS__MAX_WAIT_S=20.0
PGSCATALOG_LINK_PGS__MAX_RETRIES=2
PGSCATALOG_LINK_PGS__BACKOFF_BASE_S=2.0
PGSCATALOG_LINK_PGS__MAX_RESPONSE_BYTES=16777216
# In-process response cache (no on-disk state)
PGSCATALOG_LINK_PGS__CACHE_TTL_S=3600
PGSCATALOG_LINK_PGS__CACHE_MAXSIZE=512
